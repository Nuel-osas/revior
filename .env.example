# Documentation template. No application consumes these variables yet.
# Copy to a private environment file only after implementing configuration validation.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://secondlook:replace-me@localhost:5432/secondlook

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-service.example/auth/google/callback
AUTH_SESSION_SECRET=
PUBLIC_BASE_URL=https://your-service.example
# Basic identity only; Gmail scopes are intentionally absent.
GOOGLE_SCOPES=openid,email,profile

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
TYPESAFE_API_KEY=
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest

# Mainnet is required for the hackathon submission.
MEMWAL_NETWORK=mainnet
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
MEMWAL_ACCOUNT_ID=
MEMWAL_DELEGATE_KEY=

# Generate separately; never reuse keys between purposes/environments.
CONTENT_ENCRYPTION_KEY_BASE64=
CONTENT_ENCRYPTION_KEY_VERSION=1
NAMESPACE_HMAC_KEY_BASE64=
NAMESPACE_DERIVATION_VERSION=1

USER_DAILY_ANALYSIS_LIMIT=20
MAX_ACTIVE_CASES_PER_USER=5
MAX_SOURCE_CODEPOINTS=8000
PROVIDER_TIMEOUT_MS=20000
MEMWAL_RECALL_LIMIT=8
MEMWAL_RECALL_MAX_TOKENS=6000
CASE_INACTIVITY_RETENTION_DAYS=90
ASSESSMENT_RETENTION_DAYS=7
INTAKE_RETENTION_HOURS=1
# Set a measured budget before a live pilot; startup must reject an empty value in production.
DAILY_SPEND_LIMIT_USD=

# Owner key intentionally omitted. Provisioning/deletion uses a separate restricted environment.
