{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondlook.example/contracts/assessment.schema.json",
  "title": "SecondLook assessment v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "assessment_id",
    "case_id",
    "input_event_id",
    "disposition",
    "completeness",
    "observations",
    "unknowns",
    "next_check",
    "limitations",
    "general_context"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "assessment_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "input_event_id": {
      "type": "string",
      "format": "uuid"
    },
    "disposition": {
      "enum": [
        "change_detected",
        "needs_context",
        "no_supported_change",
        "comparison_unavailable"
      ]
    },
    "completeness": {
      "enum": [
        "complete_for_selected_claims",
        "partial",
        "unavailable"
      ]
    },
    "observations": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text",
          "sources"
        ],
        "properties": {
          "kind": {
            "enum": [
              "contradiction",
              "new_condition",
              "consistent",
              "reported_resolution",
              "unresolved"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "event_id",
                "claim_id",
                "quote"
              ],
              "properties": {
                "event_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "claim_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "quote": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "next_check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "reason"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "general_context": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "event_id",
          "revision",
          "statement",
          "purpose"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "format": "uuid"
          },
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "revision": {
            "type": "integer",
            "minimum": 1
          },
          "statement": {
            "type": "string",
            "minLength": 1
          },
          "purpose": {
            "enum": [
              "user_preference",
              "other_opportunity_check"
            ]
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "completeness": {
            "enum": [
              "partial",
              "unavailable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "change_detected"
          }
        }
      },
      "then": {
        "properties": {
          "observations": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completeness": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "disposition": {
            "const": "comparison_unavailable"
          }
        }
      }
    }
  ]
}
