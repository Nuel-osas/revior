{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondlook.example/contracts/general-memory-event.schema.json",
  "title": "SecondLook private general-memory event v1",
  "description": "Proposed archive contract. Eligibility and source ownership require domain validation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "tenant_id",
    "item_id",
    "revision",
    "kind",
    "statement",
    "recorded_at",
    "supersedes_event_id",
    "source_references"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "confirmed_preference",
        "open_check_reference"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "supersedes_event_id": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_references": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "$ref": "#/$defs/opportunity_source"
          },
          {
            "$ref": "#/$defs/confirmation_source"
          }
        ]
      }
    }
  },
  "$defs": {
    "opportunity_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "case_id",
        "event_id",
        "claim_id",
        "source_revision"
      ],
      "properties": {
        "type": {
          "const": "opportunity_event"
        },
        "case_id": {
          "type": "string",
          "format": "uuid"
        },
        "event_id": {
          "type": "string",
          "format": "uuid"
        },
        "claim_id": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "confirmation_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "confirmation_id",
        "confirmed_at"
      ],
      "properties": {
        "type": {
          "const": "user_confirmation"
        },
        "confirmation_id": {
          "type": "string",
          "format": "uuid"
        },
        "confirmed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "confirmed_preference"
          }
        }
      },
      "then": {
        "properties": {
          "source_references": {
            "minItems": 1,
            "maxItems": 1,
            "items": {
              "$ref": "#/$defs/confirmation_source"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "open_check_reference"
          }
        }
      },
      "then": {
        "properties": {
          "source_references": {
            "items": {
              "$ref": "#/$defs/opportunity_source"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "supersedes_event_id": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "supersedes_event_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      }
    }
  ]
}
