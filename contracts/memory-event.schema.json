{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://secondlook.example/contracts/memory-event.schema.json",
  "title": "SecondLook memory event v1",
  "description": "Proposed application contract. The example domain is an identifier, not a deployed service.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "event_id",
    "tenant_id",
    "case_id",
    "case_sequence",
    "kind",
    "recorded_at",
    "occurred_at",
    "source",
    "claims",
    "correction",
    "verification",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_id": {
      "type": "string",
      "format": "uuid"
    },
    "case_sequence": {
      "type": "integer",
      "minimum": 1
    },
    "kind": {
      "enum": [
        "source_message",
        "user_correction",
        "verification_report"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "occurred_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "kind",
        "text",
        "redacted",
        "claimed_sender"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "telegram_forward",
            "pasted_text",
            "user_statement"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8000
        },
        "redacted": {
          "type": "boolean"
        },
        "claimed_sender": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "correction": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/correction"
        }
      ]
    },
    "verification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/verification"
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "extractor",
        "requested_model",
        "returned_model",
        "prompt_version"
      ],
      "properties": {
        "extractor": {
          "enum": [
            "deepseek",
            "user_confirmed"
          ]
        },
        "requested_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "returned_model": {
          "type": [
            "string",
            "null"
          ]
        },
        "prompt_version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "topic",
        "statement",
        "attribution",
        "evidence"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "format": "uuid"
        },
        "topic": {
          "enum": [
            "identity",
            "role",
            "compensation",
            "applicant_fee",
            "onboarding_channel",
            "requested_action",
            "deadline",
            "other"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "enum": [
            "source_sender_claim",
            "user_interpretation",
            "user_reported_verification"
          ]
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "quote",
            "start",
            "end"
          ],
          "properties": {
            "quote": {
              "type": "string",
              "minLength": 1
            },
            "start": {
              "type": "integer",
              "minimum": 0
            },
            "end": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "target_claim_ids",
        "reason"
      ],
      "properties": {
        "action": {
          "enum": [
            "replace",
            "withdraw"
          ]
        },
        "target_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_claim_ids",
        "question",
        "method",
        "result",
        "outcome",
        "independence",
        "remaining_uncertainty"
      ],
      "properties": {
        "target_claim_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "enum": [
            "reported_confirmed",
            "reported_denied",
            "inconclusive"
          ]
        },
        "independence": {
          "enum": [
            "user_reports_independent_channel",
            "same_channel",
            "unknown"
          ]
        },
        "remaining_uncertainty": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "source_message"
          }
        }
      },
      "then": {
        "properties": {
          "correction": {
            "type": "null"
          },
          "verification": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "user_correction"
          }
        }
      },
      "then": {
        "properties": {
          "correction": {
            "$ref": "#/$defs/correction"
          },
          "verification": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "verification_report"
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "$ref": "#/$defs/verification"
          },
          "correction": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "user_correction"
          },
          "correction": {
            "type": "object",
            "properties": {
              "action": {
                "const": "replace"
              }
            },
            "required": [
              "action"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "user_correction"
          },
          "correction": {
            "type": "object",
            "properties": {
              "action": {
                "const": "withdraw"
              }
            },
            "required": [
              "action"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "claims": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
